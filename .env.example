# Copier vers .env sur le VPS. Ne jamais committer .env.
APP_DOMAIN=analytics.example.com
ACME_EMAIL=admin@example.com
POSTGRES_DB=maarif_analytics
POSTGRES_USER=maarif
POSTGRES_PASSWORD=replace-with-a-long-random-password
BUSINESS_TIMEZONE=Africa/Casablanca
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password-123A
BOOTSTRAP_ADMIN_NAME="Administrateur Maarif"
DEMO_DATA_ENABLED=false
# Générer avec : openssl rand -base64 32
JWT_SECRET=replace-with-a-base64-encoded-256-bit-secret
JWT_ISSUER=maarif-analytics
JWT_AUDIENCE=maarif-analytics-web
JWT_ACCESS_TOKEN_LIFETIME=15m
LOGIN_RATE_LIMIT=10
UPLOAD_RATE_LIMIT=20
EXPENSIVE_RATE_LIMIT=30
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT=30000
